DATABASE_URL="mysql://air_user:password@localhost:3306/voice_analyzer"
# Docker, MariaDB на хосте или с проброшенным портом 3306:
# DATABASE_URL="mysql://air_user:password@host.docker.internal:3306/voice_analyzer"
# Docker, MariaDB в той же docker-сети (имя контейнера или сервиса compose):
# DATABASE_URL="mysql://air_user:password@имя_контейнера:3306/voice_analyzer"
#
# Пользователь БД должен принимать подключения не только с localhost
# (например air_user@'%' или с docker-подсети).
#
# Первый запуск контейнера на пустую схему (потом убери):
# RUN_DB_SETUP=1

# Локально (npm run whisper):
WHISPER_URL="http://127.0.0.1:8080/inference"
# В docker compose это перекрывается на http://whisper:8080/inference

LLM_BASE_URL="https://my-test/api"
LLM_API_KEY="sk-0000"
LLM_MODEL="your-model-id"
LLM_DOCUMENT_MAX_CHARS=12000
LLM_REQUEST_TIMEOUT_MS=120000
LLM_TEMPERATURE=0.12

LLM_GLOSSARY_MAX_CHARS=32000
